# Managed by the POS Ansible deployment. Other vhosts remain unchanged.
server {
{% for endpoint in pos_http_listeners | default(['80'] + (['[::]:80'] if ansible_all_ipv6_addresses | default([]) | length > 0 else [])) %}
    listen {{ endpoint }};
{% endfor %}
    server_name {{ pos_domain }};
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/pos-deploy/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
{% if pos_tls_ready %}
        return 301 https://{{ pos_domain }}$request_uri;
{% else %}
        return 503 "SSL setup in progress.\n";
{% endif %}
    }
}
{% if pos_tls_ready %}
server {
{% for endpoint in pos_https_listeners | default(['443'] + (['[::]:443'] if ansible_all_ipv6_addresses | default([]) | length > 0 else [])) %}
    listen {{ endpoint }} ssl;
{% endfor %}
    server_name {{ pos_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ pos_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ pos_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/pos/current;
    index index.html;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 16k;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
    }
    location / { try_files $uri $uri/ =404; }
    location = /sw.js { add_header Cache-Control "no-cache" always; }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
    }
    location = /healthz.json { add_header Cache-Control "no-store" always; }
    location ~ /\. { deny all; }
}
{% endif %}
